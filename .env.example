# PostgreSQL production database settings
POSTGRES_DB=dms
POSTGRES_USER=dmsuser
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DJANGO_SECRET_KEY=change-this-secret-key
DJANGO_DEBUG=False
DJANGO_USE_SQLITE=True
OCR_TESSERACT_CMD=
OCR_POPPLER_PATH=
